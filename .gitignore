# ============================================================================
# ALLOW LIST (exceptions) & Git Rules for Submission
# ============================================================================
# Keep config, script and source files
!config/
!scripts/
!utils/

# Keep standard traffic datasets (needed to run simulations)
!data/
# Ignore generated FinetuneData subdirs except litepp final results
data/FinetuneData/llamafactory_litepp_rco/
data/FinetuneData/llamafactory_litepp_dpo/
data/FinetuneData/litepp/litepp_rco_raw_100_1.jsonl
data/FinetuneData/litepp/litepp_rco_rollout_100_1.jsonl
data/FinetuneData/litepp/litepp_rco_teacher_100_1.jsonl
data/NewYork/

# Ignore all temporary/sample rollout runs, but KEEP the final eval runs for the Dashboard
records/*
!records/litepp_eval_jinan_3x4/
!records/litepp_eval_hangzhou_4x4/

# Keep the LoRA adapter model weights and configs (only ~37MB)
!qwen_lora_rco/
qwen_lora_rco/**/checkpoint-*/
qwen_lora_rco/LLaMA-Factory/data/
qwen_lora_rco/LLaMA-Factory/saves/Qwen2.5-1.5B-RCO-LoRA/checkpoint-*/

# Ignore old/deprecated model folders and log files
qwen_lora_rco_OLD/
*.log

# Keep outputs
!outputs/
!outputs/litepp_eval_results.csv